# Inquiry form endpoint (optional).
# When set, the contact form POSTs JSON to this URL (e.g. a Formspree/Basin/Getform
# endpoint or your own API route). When empty, the form opens a pre-filled email to
# the sales team instead — it never shows a success message it can't back up.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Canonical site URL used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://drychem.com

# Set to 1 on preview deployments to keep every page out of search results
# (adds <meta name="robots" content="noindex, nofollow">). Leave empty for the live site.
SITE_NOINDEX=

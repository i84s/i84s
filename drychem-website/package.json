{
  "name": "drychem-website",
  "version": "1.0.0",
  "private": true,
  "description": "DRYCHEM \u2014 Engineering Excellence. Built to Last. A premium corporate website experience.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && prettier --check .",
    "assets:materials": "python3 scripts/render_materials.py && node scripts/build-images.mjs",
    "assets:map": "node scripts/build-map.mjs",
    "qa": "node scripts/qa.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "d3-geo": "3.1.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "2.0.2"
  }
}
